# URL del api-gateway. Ver MOBILE.md §5.2.
# Navegador (vite dev en 5173, preview en 4173): el origen debe estar en Cors:AllowedOrigins.
VITE_GATEWAY_URL=http://localhost:8080

# Emulador Android: localhost es el propio emulador, 10.0.2.2 es el host.
# VITE_GATEWAY_URL=http://10.0.2.2:8080

# Dispositivo fisico en la misma LAN.
# VITE_GATEWAY_URL=http://<ip-del-host>:8080

# Release.
# VITE_GATEWAY_URL=https://api.peaker.app

# Proveedor de teselas del mapa. Sin valor se usa OpenStreetMap.
# Leaflet pide las teselas con <img>, que no pasa por CapacitorHttp sino por el WebView,
# asi que la URL tiene que ser https: con http: Android la bloquea sin avisar y el mapa
# queda en blanco. Ver MOBILE.md §5.4.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap
