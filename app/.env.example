# URL del api-gateway. Ver MOBILE.md §5.2.
# Navegador (vite dev en 5173, preview en 4173): el origen debe estar en Cors:AllowedOrigins.
VITE_GATEWAY_URL=http://localhost:8080

# Emulador Android: localhost es el propio emulador, 10.0.2.2 es el host.
# VITE_GATEWAY_URL=http://10.0.2.2:8080

# Dispositivo fisico en la misma LAN.
# VITE_GATEWAY_URL=http://<ip-del-host>:8080

# Release.
# VITE_GATEWAY_URL=https://api.peaker.es

# Proveedor de teselas del mapa. Sin valor se usa OpenStreetMap.
# Leaflet pide las teselas con <img>, que no pasa por CapacitorHttp sino por el WebView,
# asi que la URL tiene que ser https: con http: Android la bloquea sin avisar y el mapa
# queda en blanco. Ver MOBILE.md §5.4.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap

# Mapa apagado mientras no haya proveedor con uso comercial (blockers.md §B5).
# Sin este valor a false, npm run check:tiles falla: una app publicada no puede
# consumir las teselas de openstreetmap.org.
VITE_MAP_ENABLED=false

# Nombre del proveedor tal y como lo nombran los textos legales. Sin valor, OpenStreetMap.
# VITE_MAP_PROVIDER_NAME=MapTiler

# Base publica del portal, usada por SC-16 para previsualizar la URL del perfil.
# Ver MOBILE.md §6 B6. Sin valor se usa https://peaker.es.
# VITE_SITE_URL=https://peaker.es

# Ficha del titular, vendorizada desde el portal con el prefijo VITE_ en lugar de leerse de
# process.env. Los mismos valores que LEGAL_* en peaker-web/portal/.env. Ver LEGAL.md.
# NO se versionan: van en .env, que .gitignore excluye.
VITE_LEGAL_HOLDER=[PENDIENTE: nombre o razón social del titular]
VITE_LEGAL_TAX_ID=[PENDIENTE: NIF]
VITE_LEGAL_ADDRESS=[PENDIENTE: domicilio completo]
VITE_LEGAL_EMAIL=[PENDIENTE: correo de contacto]
# VITE_LEGAL_DPO=
